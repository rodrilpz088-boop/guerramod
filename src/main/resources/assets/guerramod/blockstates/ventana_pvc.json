{
 "multipart": [
  {
   "apply": {
    "model": "guerramod:block/ventana_pvc_post"
   }
  },
  {
   "when": {
    "north": "true"
   },
   "apply": {
    "model": "guerramod:block/ventana_pvc_side"
   }
  },
  {
   "when": {
    "east": "true"
   },
   "apply": {
    "model": "guerramod:block/ventana_pvc_side",
    "y": 90
   }
  },
  {
   "when": {
    "south": "true"
   },
   "apply": {
    "model": "guerramod:block/ventana_pvc_side_alt"
   }
  },
  {
   "when": {
    "west": "true"
   },
   "apply": {
    "model": "guerramod:block/ventana_pvc_side_alt",
    "y": 90
   }
  },
  {
   "when": {
    "north": "false"
   },
   "apply": {
    "model": "guerramod:block/ventana_pvc_noside"
   }
  },
  {
   "when": {
    "east": "false"
   },
   "apply": {
    "model": "guerramod:block/ventana_pvc_noside_alt"
   }
  },
  {
   "when": {
    "south": "false"
   },
   "apply": {
    "model": "guerramod:block/ventana_pvc_noside_alt",
    "y": 90
   }
  },
  {
   "when": {
    "west": "false"
   },
   "apply": {
    "model": "guerramod:block/ventana_pvc_noside",
    "y": 270
   }
  }
 ]
}